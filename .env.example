# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Refold (shared across all CRMs) — https://docs.refold.ai
# ---------------------------------------------------------------------------
REFOLD_BASE_URL=https://app.refold.ai
REFOLD_ORG_ID=

# Org-level API key ("API key for your workspace" in the Refold dashboard).
# Preferred over a linked-account Bearer token — doesn't expire the way the
# short-lived (~7 day observed) session JWTs do. Sent as `x-api-key`.
REFOLD_API_KEY=

# One linked_account_id per CRM connection (identifies which connected
# account a workflow/execution belongs to — sent as the `linked_account_id`
# header alongside REFOLD_API_KEY above).
REFOLD_HUBSPOT_LINKED_ACCOUNT_ID=
REFOLD_SALESFORCE_LINKED_ACCOUNT_ID=
REFOLD_PIPEDRIVE_LINKED_ACCOUNT_ID=
REFOLD_ZOHO_LINKED_ACCOUNT_ID=

# Short-lived linked-account session JWT (~7 day expiry, from the pyxis
# integrations page's network tab). ONLY needed for Refold's internal
# /api/v2/f-sdk/* config endpoints (reading a workflow's live `enabled`
# flag / configured action) — confirmed live that those reject the org API
# key entirely. Everything else (Executions API) uses REFOLD_API_KEY.
REFOLD_HUBSPOT_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# SalesHandy Open API. SalesHandy's public docs list
# https://open-api.saleshandy.com/v1 as "the" base URL, but that host
# rejects pyxis-issued keys with a 400 "Invalid token" — confirmed live.
# Each environment has its own gateway host; pyxis (staging)'s is below.
# This, not just the key, is what scopes every call to pyxis — see
# knowledge_base/execution-plan.md §10.
# ---------------------------------------------------------------------------
SALESHANDY_BASE_URL=https://pyxis-open-api-gateway.lifeisgoodforlearner.com/v1
# From the pyxis account: Settings > API. Must be a key issued from the
# pyxis (test) account — never one from a production SalesHandy account.
SALESHANDY_API_TOKEN=

# SalesHandy's internal "edge" API (session-JWT auth, NOT the Open API
# above) — used ONLY for the "Send Now" override (see
# src/clients/saleshandy/saleshandy-edge-client.ts and execution-plan.md
# §9). Get from the pyxis dashboard's network tab.
SALESHANDY_EDGE_BASE_URL=https://pyxis.lifeisgoodforlearner.com/api/edge
SALESHANDY_EDGE_SESSION_TOKEN=

# The sender account a test sequence sends from (must already be a
# connected email account in the pyxis account). Use an SMTP/IMAP-connected
# account, not a Gsuite-OAuth one — confirmed live 2026-09-17 that
# reply-detection did not work reliably from a Gsuite-connected sender.
SALESHANDY_SENDER_EMAIL=

# The prospect/reply mailbox. Must be a DIFFERENT Google account from the
# sender above, never registered with SalesHandy — confirmed live
# 2026-09-17 that connecting an account as a sender lets SalesHandy's own
# sync activity starve Gmail's per-account IMAP connection limit, which
# then blocks our own polling if sender/prospect share one account. See
# execution-plan.md §9 and src/clients/mailbox/test-mailbox-client.ts.
SALESHANDY_TEST_PROSPECT_BASE_EMAIL=

# ---------------------------------------------------------------------------
# Test mailbox automation — reads the outbound test email via IMAP and
# sends a threaded reply via SMTP, fully automating the "reply" step.
# Credentials for the PROSPECT account above, NOT the sender.
# ---------------------------------------------------------------------------
TEST_MAILBOX_IMAP_HOST=imap.gmail.com
TEST_MAILBOX_IMAP_PORT=993
TEST_MAILBOX_SMTP_HOST=smtp.gmail.com
TEST_MAILBOX_SMTP_PORT=465
TEST_MAILBOX_USERNAME=
TEST_MAILBOX_APP_PASSWORD=

# ---------------------------------------------------------------------------
# HubSpot — Settings > Integrations > Service Keys (or Legacy Private App)
# ---------------------------------------------------------------------------
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Salesforce — Connected App (OAuth) credentials
# ---------------------------------------------------------------------------
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# ---------------------------------------------------------------------------
# Pipedrive — Settings > Personal preferences > API
# ---------------------------------------------------------------------------
PIPEDRIVE_BASE_URL=https://api.pipedrive.com/v1
PIPEDRIVE_API_TOKEN=

# ---------------------------------------------------------------------------
# Zoho CRM — OAuth token (self-client / server-based app)
# ---------------------------------------------------------------------------
ZOHO_BASE_URL=https://www.zohoapis.com
ZOHO_ACCESS_TOKEN=
ZOHO_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Harness behavior
# ---------------------------------------------------------------------------
LOG_LEVEL=info
TEST_RESULTS_DIR=./test-results
# Max ms to wait for a Refold execution to appear/complete before failing.
REFOLD_EXECUTION_TIMEOUT_MS=120000


RECIPIENT_EMAIL_APP_PASSWORD=