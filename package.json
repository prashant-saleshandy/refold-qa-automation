    "dotenv": "^16.4.7",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.29",
    "nodemailer": "^10.0.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
