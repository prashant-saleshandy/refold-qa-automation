{
  "name": "refold-qa-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Automated QA harness for SalesHandy <-> Refold <-> CRM (HubSpot, Salesforce, Pipedrive, Zoho) integration workflows.",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
